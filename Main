function OU.resolve(U, P)
	if not P then
		return OU.resolve(U, OU.locations) or OU.resolve(U, OU.poi);
	end;
	if P[U] then
		return P[U];
	end;
	local m = string.lower(U or "");
	for U, P in pairs(P) do
		if string.lower(U) == m then
			return P;
		end;
	end;
	return nil;
end;
function OU.matchName(U, P)
	if not U or U == "" then
		return nil;
	end;
	U = string.lower(U);
	local m, v;
	for P in pairs(P or OU.locations) do
		local Y = string.lower(P);
		if Y == U then
			return P;
		end;
		if not m and Y:sub(1, #U) == U then
			m = P;
		end;
		if not v and Y:find(U, 1, true) then
			v = P;
		end;
	end;
	return m or v;
end;
function OU.toPos(U, P, m)
	local v = f();
	if not v then
		warn("No HumanoidRootPart");
		return false;
	end;
	pcall(function()
		v.CFrame = CFrame.new(U, P, m);
	end);
	return true;
end;
function OU.to(U, P)
	local m = OU.resolve(U, P);
	if not m then
		warn("Unknown location: " .. tostring(U));
		return false;
	end;
	return OU.toPos(m.X, m.Y, m.Z);
end;
function OU.list(U, P)
	local m = {};
	for U in pairs(U or OU.locations) do
		m[#m + 1] = U;
	end;
	table.sort(m);
	print(string.format("%d %s:", #m, P or "locations"));
	for U, P in ipairs(m) do
		print("   " .. P);
	end;
	return m;
end;
local bU = { _list = {}, _lastScan = 0 };
function bU.collect()
	local U, P = {}, {};
	local function m(U)
		if not U then
			return nil;
		end;
		local P, m = pcall(function()
				local P = U.Position;
				return ((P and P.X ~= nil)) and P or nil;
			end);
		return P and m or nil;
	end;
	local function v(v)
		local Y = m(H(v, "HumanoidRootPart")) or m(H(v, "Head"));
		if not Y then
			for U, P in ipairs(q(v)) do
				Y = m(P);
				if Y then
					break;
				end;
			end;
		end;
		if not Y then
			return;
		end;
		local Q = v.Name .. ("@" .. (math.floor(Y.X) .. ("," .. math.floor(Y.Z))));
		if not P[Q] then
			P[Q] = true;
			U[#U + 1] = { name = v.Name, pos = Y };
		end;
	end;
	local function Y(U, P)
		if not U or P > 3 then
			return;
		end;
		for U, m in ipairs(q(U)) do
			if H(m, "Humanoid") or H(m, "HumanoidRootPart") then
				v(m);
			elseif #q(m) > 0 then
				Y(m, P + 1);
			end;
		end;
	end;
	Y(H(H(Q, "world"), "npcs"), 1);
	Y(H(Q, "npcs"), 1);
	pcall(function()
		for U, P in ipairs((game:GetService("CollectionService")):GetTagged("NewNpc")) do
			v(P);
		end;
	end);
	return U;
end;
function bU.snapshot(U)
	local P = tick() * 1000;
	if (P - ((bU._lastScan or 0))) >= ((U or 10000)) then
		bU._lastScan = P;
		bU._list = bU.collect();
	end;
	return bU._list or {};
end;
