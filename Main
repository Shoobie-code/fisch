	return P;
end;
function C.unload()
	C.dead = true;
	local U = C.fastConn;
	C.fastConn = nil;
	if U then
		pcall(function()
			U:Disconnect();
		end);
	end;
	local P, m = C.conns, C.drawings;
	C.conns, C.drawings = {}, {};
	for U, P in ipairs(P) do
		pcall(function()
			P:Disconnect();
		end);
	end;
	for U, P in ipairs(m) do
		pcall(function()
			P:Remove();
		end);
	end;
	pcall(function()
		if _G.FischAppraiser then
			_G.FischAppraiser.unload();
		end;
	end);
	local v = C.lib;
	C.lib = nil;
	if v then
		pcall(function()
			if v.Destroy then
				v:Destroy();
			elseif v.Unload then
				v:Unload();
			end;
		end);
	end;
	pcall(function()
		mouse1release();
	end);
	if C.releaseKeys then
		pcall(C.releaseKeys);
	end;
end;
