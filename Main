	local nU = { "nuke", "bomb", "defuse" };
	local sU = {
			Frame = true,
			ImageLabel = true,
			ImageButton = true,
			TextLabel = true,
			TextButton = true,
			ScrollingFrame = true,
			CanvasGroup = true,
