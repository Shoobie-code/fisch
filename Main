local function A(U)
	if not U or U <= 4096 then
		return nil;
	end;
	local P, m = pcall(memory_read, "uintptr_t", U);
	m = P and tonumber(m) or nil;
	return ((m and m > 4096)) and m or nil;
end;
local function M(U)
	if not U or U <= 4096 then
		return .0;
	end;
	local P, m = pcall(memory_read, "float", U);
	return (P and tonumber(m)) or .0;
end;
local function l(U)
	if not U or U <= 4096 then
		return 0;
	end;
	local P, m = pcall(memory_read, "int32", U);
	if not P then
		P, m = pcall(memory_read, "int", U);
	end;
	return (P and tonumber(m)) or 0;
end;
local function T(U)
	if not U or U <= 4096 then
		return 0;
	end;
	local P, m = pcall(memory_read, "byte", U);
	return (P and tonumber(m)) or 0;
end;
local function c(U)
	if not U then
		return nil;
	end;
