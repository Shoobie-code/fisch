			return U.Address;
		end);
	m = ((P and m)) and tonumber(m) or nil;
	return ((m and m > 4096)) and m or nil;
end;
local function e(U)
	local P = c(U);
	if not P then
		return 0, 0, 0, 0;
	end;
	local m = P + O.FramePositionX;
	return M(m + 0), l(m + 4), M(m + 8), l(m + 12);
end;
local function i(U)
	local P = c(U);
	if not P then
		return 0, 0, 0, 0;
	end;
	local m = P + O.FrameSizeX;
	return M(m + 0), l(m + 4), M(m + 8), l(m + 12);
end;
local function R(U)
	if not U then
		return false;
	end;
	local P, m = pcall(function()
			return U.Enabled;
		end);
	if P and type(m) == "boolean" then
		return m;
	end;
	local v = c(U);
	if not v then
		return true;
	end;
	return T(v + O.ScreenGuiEnabled) ~= 0;
end;
local function V(U)
	if not U then
		return "";
	end;
	local P = l(U + O.StringLength);
	if P <= 0 or P > 1000 then
		return "";
	end;
	local m = U;
	if P > 15 then
		m = A(U);
	end;
	if not m then
		return "";
	end;
	local v, Y = pcall(memory_read, "string", m);
	return ((v and type(Y) == "string")) and Y or "";
end;
local function j(U)
	if not U then
		return "";
	end;
	local P, m = pcall(function()
			return U.Text;
		end);
	if P and (type(m) == "string" and m ~= "") then
		return m;
	end;
	local v = c(U);
	return v and V(v + O.TextLabelText) or "";
end;
local function Z(U, P, m)
	if type(U) ~= "number" then
		return false;
	end;
	if U ~= U or U == math.huge or U == -math.huge then
		return false;
	end;
	if P and U < P then
		return false;
	end;
	if m and U > m then
		return false;
	end;
	return true;
end;
local function H(U, P)
	if not U then
		return nil;
	end;
	local m, v = pcall(U.FindFirstChild, U, P);
	return m and v or nil;
end;
local function q(U)
	if not U then
		return {};
	end;
	local P, m = pcall(U.GetChildren, U);
	return (P and m) or {};
end;
