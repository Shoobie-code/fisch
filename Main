	end;
	local function x(U, P)
		if not P and (U - H.shakeAt) < v.shake then
			return;
		end;
		local m = q(U);
		local Y = m and V(m, "shakeui");
		local Q = Y and V(Y, "safezone");
		local a = g(Q);
		H.shakeGui, H.safezone, H.button = Y, Q, a;
		H.shakeAddr = l(Y);
		H.safezoneAddr = l(Q);
		H.buttonAddr = l(a);
		H.shakeAt = U;
	end;
	local function n(U)
		x(U);
		if H.button and not ((T(H.button) and (T(H.safezone) and T(H.shakeGui)))) then
			x(U, true);
		end;
		if not ((H.shakeGui and (H.safezone and H.button))) then
			return false;
		end;
		return i(H.shakeGui, H.shakeAddr) and (R(H.safezone, H.safezoneAddr) and R(H.button, H.buttonAddr));
	end;
	local s = {
			Enter = 13,
			F1 = 112,
			End = 35,
			Q = 81,
			E = 69,
		};
	local t = {};
	local E = {};
	local u = 20;
	local function r(U)
		for P, m in pairs(t) do
			if U >= m then
				t[P] = nil;
				keyrelease(P);
			end;
		end;
	end;
	local function w()
		r(math.huge);
	end;
	local function I(U, P, m)
		m = m or (tick() * 1000);
		if t[U] then
			return false;
		end;
		local v = E[U];
		if v and m < v then
			return false;
		end;
		P = P or 25;
		keypress(U);
		t[U] = m + P;
		E[U] = (m + P) + u;
		return true;
	end;
	local function d()
		return I(s.Enter, 30);
	end;
	local function S(U)
		local P = tostring(U or "");
		local m = tonumber(P);
		if m and ((m >= 0 and m <= 9)) then
			return 48 + m;
		end;
		if #P == 1 then
			local U = (P:upper()):byte();
			if U >= 65 and U <= 90 then
				return U;
			end;
		end;
		return nil;
	end;
	local function z(U)
		local P = S(U);
		if not P then
			return;
		end;
		I(P, 25);
	end;
	local F = type(iskeypressed) == "function";
	local p = type(isrbxactive) == "function";
	local UU = type(ismouse1pressed) == "function";
	if not F then
		notify("iskeypressed() unavailable - hotkeys cannot work.", "", 6);
	end;
	local function PU()
		if not p then
			return true;
		end;
		return isrbxactive() ~= false;
	end;
	local mU = type(mouse2press) == "function" and type(mouse2release) == "function";
	local vU = false;
	local YU = false;
	local QU = true;
	local aU = true;
	local CU = tick() * 1000;
	local function KU()
		if vU and QU then
			return;
		end;
		vU = true;
		CU = tick() * 1000;
		QU = pcall(mouse1press) and true or false;
	end;
	local function GU()
		if not vU then
			return;
		end;
		vU = false;
		QU = true;
		CU = tick() * 1000;
		pcall(mouse1release);
	end;
	local function LU()
		if not mU or (YU and aU) then
			return;
		end;
		YU = true;
		CU = tick() * 1000;
		aU = pcall(mouse2press) and true or false;
	end;
	local function OU()
		if not YU then
			return;
		end;
		YU = false;
		aU = true;
		CU = tick() * 1000;
		pcall(mouse2release);
	end;
	local function bU()
		GU();
		OU();
	end;
	local hU = type(mousemoveabs) == "function";
	local function AU(U, P)
		if not hU then
			return false;
		end;
		return (pcall(mousemoveabs, math.floor(U + .5), math.floor(P + .5)));
	end;
	local function MU()
		local U = W();
		if not U then
			return nil;
		end;
		return U.Character or (workspace and V(workspace, U.Name));
	end;
	local function lU()
		if U.equipKey then
			z(U.equipKey);
		end;
	end;
	local function TU()
		local U = MU();
		if not U then
			return nil;
		end;
		local P = j(U);
		if #P == 0 then
			return nil;
		end;
		for U, P in ipairs(P) do
			if P.ClassName == "Tool" then
				return true;
			end;
		end;
		return false;
	end;
	local function cU()
		local U = MU();
		if not U then
			return false;
		end;
		for U, P in ipairs(j(U)) do
			if P.ClassName == "Tool" and ((tostring(P.Name)):lower()):find("rod", 1, true) then
				return true;
			end;
		end;
		return false;
	end;
	local eU = {
			done = true,
			startedAt = 0,
			pressedAt = 0,
			attempts = 0,
		};
	local function iU(U)
		eU.done = false;
		eU.startedAt = U;
		eU.pressedAt = 0;
		eU.attempts = 0;
	end;
	local function RU(P)
		if eU.done then
			return true;
		end;
		if eU.attempts == 0 then
			if cU() then
				eU.done = true;
				return true;
			end;
			lU();
			eU.attempts = 1;
			eU.pressedAt = P;
			return false;
		end;
		if (P - eU.startedAt) >= U.equipSettleMs then
			eU.done = true;
			return true;
		end;
		if (P - eU.pressedAt) < U.equipVerifyMs then
			return false;
		end;
		local m = TU();
		if m == true then
			eU.done = true;
			return true;
		end;
		if m == nil then
			return false;
		end;
		if eU.attempts >= U.equipAttempts then
			eU.done = true;
			return true;
		end;
		lU();
		eU.attempts = eU.attempts + 1;
		eU.pressedAt = P;
		return false;
	end;
	local function VU(U, P)
		if not U then
			return nil;
		end;
		local m = O((U + Q.FrameSizeX) + P);
		if not K(m) or m < -0.05 or m > 1.5 then
			return nil;
		end;
		return G(m * 100.0, .0, 100.0);
	end;
	local function jU(U)
		return VU(U, 0);
	end;
	local function ZU(U)
		if H.powerBar and (U - H.powerAt) < v.power then
			local U = c(H.powerBar, H.powerAddr);
			if U then
				return U;
			end;
		end;
		local P = MU();
		local m = P and V(P, "HumanoidRootPart");
		local Y = m and V(m, "power");
		H.powerBar = Y and Z(Y, "bar") or nil;
		H.powerAddr = l(H.powerBar);
		H.powerAt = U;
		return H.powerAddr;
	end;
	local function HU(U)
		return VU(U, 8);
	end;
	local function qU()
		return G(U.castPower, 1.0, 100.0);
	end;
	local yU = {
			EdgeBoundary = .1,
			StaleTickS = .12,
			MinDwellS = .033,
			WarmupS = .12,
			MaxVelocity = 3.0,
			BarVelTauS = .015,
			FishVelTauS = .015,
			Kp = 200.0,
			Ki = 1.0,
			Kd = 2.0,
			IntegralClamp = .2,
			HoldAccel = .3,
			DropAccel = .15,
		};
	local XU = {};
	XU.__index = XU;
	function XU.new(U, P)
		local m = setmetatable({}, XU);
		m.hold = U;
		m.release = P;
		m:Reset();
		return m;
	end;
	function XU.Reset(U)
		local P = tick();
		U.samples = 0;
		U.lastTickAt = P;
		U.warmUntil = P + yU.WarmupS;
		U.prevFish = .0;
		U.prevBar = .0;
		U.lastFishRaw = nil;
		U.lastBarRaw = nil;
		U.fishVel = .0;
		U.barVel = .0;
		U.errInt = .0;
		U.duty = .5;
		U.sigma = .0;
		U.slotAt = .0;
		U.pressed = false;
		U.lastHalfWidth = nil;
	end;
	function XU._Plan(U, P, m, v, Y)
		local Q = ((P - U.prevFish)) / v;
		local a = ((m - U.prevBar)) / v;
		U.prevFish, U.prevBar = P, m;
		local C = 1.0 - math.exp(-v / Y.FishVelTauS);
		local K = 1.0 - math.exp(-v / Y.BarVelTauS);
		U.fishVel = U.fishVel + (C * ((G(Q, -Y.MaxVelocity, Y.MaxVelocity) - U.fishVel)));
		U.barVel = U.barVel + (K * ((G(a, -Y.MaxVelocity, Y.MaxVelocity) - U.barVel)));
		local L = U.barVel - U.fishVel;
		local O = (L > .0) and Y.DropAccel or Y.HoldAccel;
		local b = ((L * math.abs(L))) / ((2.0 * O));
		local h = ((P - m)) - b;
		U.errInt = G(U.errInt + (((Y.Ki * h)) * v), -Y.IntegralClamp, Y.IntegralClamp);
		local A = Y.HoldAccel + Y.DropAccel;
		U.duty = G(((((((Y.Kp * h) - (Y.Kd * L))) + Y.DropAccel)) / A) + U.errInt, .0, 1.0);
	end;
	function XU.UpdateHybrid(U, P, m, v)
		local Y = yU;
		local Q = tick();
		local a = (v >= .01) and math.min(.5, v * .5) or Y.EdgeBoundary;
		local C, K = a, 1.0 - a;
		local L = math.min(Y.EdgeBoundary, math.max(.004, a * .5));
		local O = G(P, C, K);
		if U.lastHalfWidth == nil then
			U.lastHalfWidth = a;
		elseif math.abs(a - U.lastHalfWidth) > .004 then
			U.lastHalfWidth = a;
			U.errInt = .0;
		end;
		local b = O - m;
		if (m < (C + L) and b > 0) or (m > (K - L) and b < 0) then
			if m ~= U.lastBarRaw then
				U.lastFishRaw, U.lastBarRaw = P, m;
				U.lastTickAt = Q;
				U.prevFish, U.prevBar = O, m;
			end;
			U.slotAt = Q - Y.MinDwellS;
			U.pressed = b > 0;
			if U.pressed then
				U.hold();
			else
				U.release();
			end;
			return;
		end;
		local h = Q - U.lastTickAt;
		if m == U.lastBarRaw then
			if h < Y.StaleTickS then
				return;
			end;
			U.lastFishRaw, U.lastBarRaw = P, m;
			U.lastTickAt = Q;
			U.prevFish, U.prevBar = O, m;
			if b > 0 then
				U.hold();
			else
				U.release();
			end;
			return;
		end;
		U.lastFishRaw, U.lastBarRaw = P, m;
		U.lastTickAt = Q;
		h = G(h, .001, .1);
		U.samples = U.samples + 1;
		if U.samples <= 2 or Q < U.warmUntil then
			U.prevFish, U.prevBar = O, m;
			if b > math.max(.015, v * .04) then
				U.hold();
			else
				U.release();
			end;
			return;
		end;
		U:_Plan(O, m, h, Y);
		if (Q - U.slotAt) >= Y.MinDwellS then
			U.slotAt = Q;
			U.sigma = U.sigma + U.duty;
			U.pressed = U.sigma >= 1.0;
			if U.pressed then
				U.sigma = U.sigma - 1.0;
			end;
		end;
		if U.pressed then
			U.hold();
		else
			U.release();
		end;
	end;
	function XU.Update(U, P, m, v)
		if not ((K(P) and K(m))) then
			U.release();
			return;
		end;
		if not K(v) or v < .001 then
			v = .001;
		elseif v > 2.0 then
			v = 2.0;
		end;
		return U:UpdateHybrid(P, m, v);
	end;
	local fU = XU.new(KU, GU);
	local kU = XU.new(LU, OU);
	local NU = { { ctrl = fU, release = GU }, { ctrl = kU, release = OU } };
	local WU = { nil, nil };
	local function oU(U)
		WU[U] = nil;
		y.driven[U] = nil;
		NU[U].ctrl:Reset();
		NU[U].release();
	end;
	local function DU()
		for U = 1, #NU, 1 do
			oU(U);
		end;
	end;
	local BU = false;
	local function JU()
		if BU then
			return;
		end;
		BU = true;
		notify("Second reel found but mouse2press() is missing - only the left-click fish will be reeled.", "", 6);
	end;
	local function gU(U)
		if not U then
			return nil;
		end;
		for P = 1, #NU, 1 do
			if WU[P] == U then
				return P;
			end;
		end;
		return nil;
	end;
	local xU = {
			phase = "OFF",
			castStartedAt = 0,
			castPressAt = 0,
			castReleasedAt = 0,
			castBarSeen = false,
			castArmed = false,
