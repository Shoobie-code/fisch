				notify("webhook_url.txt is empty. Paste your webhook URL into it first.", "", 5);
			end;
		end });
	U(N, "webhook_enabled", "Enable webhook");
	U(N, "webhook_on_start", "Send startup message");
	U(N, "webhook_stats", "Send periodic stats");
	P(N, "webhook_interval_s", "Stats interval (sec)", 30, 3600);
	N:AddButton({ text = "Send test stats now", callback = function()
			LU.sendAsync(LU.stats());
		end });
	local x = B:AddSettingsTab("settings", { unload = false });
	(x:AddGroup("Macro", 2)):AddButton({
		text = "Unload menu",
		badge = "!",
		confirm = true,
		tooltip = "Remove the menu and stop the macro?",
		callback = function()
			B:Unload();
		end,
	});
	pcall(function()
		B:LoadSettings();
	end);
	do
		local U = G();
		if U ~= "" then
			pcall(function()
				W:Set(U);
			end);
		end;
	end;
	local n = 0;
	C.statusTick = function()
			if not B or C.dead then
				return;
			end;
			if tick() - n < .1 then
				return;
			end;
			n = tick();
			pcall(function()
				if not B:IsVisible() then
					return;
				end;
				local U = s.running and "auto fishing" or "idle";
				local P = string.format("%s | %s\nRod: %s\nCaught: %d   Lost: %d   Timeouts: %d   Recover: %d", U, F(), s.rod ~= "" and s.rod or "none", s.caught, s.lost, s.timeouts, s.recoveries);
				if P == C.statusText then
					return;
				end;
				K:SetText(P);
				C.statusText = P;
			end);
		end;
end;
if L.wp_show_on_load then
	pcall(KU.show);
end;
if L.chest_show_on_load then
	pcall(GU.show);
end;
if L.autostart then
	z(true);
end;
local function TU(U)
	if not J and d(r.autofishFallback) then
		z(not s.running);
	end;
	PU();
	pcall(MU.step);
	pcall(GU.runStep);
end;
local function cU()
	local U = o.isEnabled();
	if U == s.running then
		return;
	end;
	s.running = U;
	if J and not g then
		g = true;
		pcall(function()
			J:Set(U);
		end);
		g = false;
	end;
end;
local function eU()
	local U = "";
	for P, m in ipairs(X()) do
		for P, m in ipairs(q(m)) do
			local v, Y = pcall(function()
					return m.ClassName;
				end);
			if v and Y == "Tool" then
				U = tostring(m.Name);
				break;
			end;
		end;
		if U ~= "" then
			break;
		end;
	end;
	s.rod = U;
end;
local function iU()
	cU();
	if tick() - ((C.rodAt or 0)) >= 1 and ((s.running or L.webhook_enabled or (B and B:IsVisible()))) then
		C.rodAt = tick();
		pcall(eU);
	end;
	pcall(LU.maybeStartup);
	pcall(LU.statsTick);
	if C.statusTick then
		pcall(C.statusTick);
	end;
end;
do
	local U = 1.0 / math.max(1, tonumber(L.macro_tick_hz) or 60);
	local P = math.max(1, tonumber(L.macro_max_catchup) or 3);
	local m, Y = .0, tick();
	local Q = .0;
	local a = .0;
	local K = false;
	local function G()
		local U = o.CONFIG.mode;
		local P = false;
		if ((U == "spear" or U == "gun")) and o.isEnabled() then
			local m = y();
			local v = U == "spear" and o.CONFIG.stabGuiName or o.CONFIG.gunGuiName;
			P = m ~= nil and H(m, v) ~= nil;
		end;
		if P then
			if not K and (B and B:IsVisible()) then
				B:SetVisible(false);
				K = true;
			end;
		elseif K then
			K = false;
			if B and not B:IsVisible() then
				B:SetVisible(true);
			end;
		end;
	end;
	local function O(v)
		local a = v - Y;
		Y = v;
		if a < 0 or a > 1.0 then
			a = U;
		end;
		m = m + a;
		local C = 0;
		while m >= U and C < P do
			m = m - U;
			C = C + 1;
			TU(U);
		end;
		if m > U * P then
			m = 0;
		end;
		if v - Q >= .05 then
			Q = v;
			iU();
			pcall(G);
		end;
	end;
	local function b()
		if C.dead then
			return;
		end;
		local U = tick();
		if U - a >= .001 then
			a = U;
			pcall(o.fastBody);
		end;
		O(U);
	end;
	local function h()
		if o.isEnabled() then
			return true;
		end;
		local U, P = pcall(o.keysOwed);
		return U and P or false;
	end;
	C.track(v.Heartbeat:Connect(function()
		if C.dead then
			return;
		end;
		local U = h();
		if U and not C.fastConn then
			C.fastConn = v.RenderStepped:Connect(b);
		elseif not U and C.fastConn then
			local U = C.fastConn;
			C.fastConn = nil;
			pcall(function()
				U:Disconnect();
			end);
		end;
		if not C.fastConn then
			O(tick());
		end;
	end));
end;
notify(D and "Loaded. F1 toggles Auto Fish." or "Loaded, but the UI failed to load (console only).", "", 4);
