local K = "webhook_url.txt";
local function G()
	local U = "";
	pcall(function()
		if isfile(K) then
			local P = (tostring(readfile(K) or "")):gsub("%s", "");
			if P ~= "" then
				U = P;
			end;
		else
			writefile(K, "");
		end;
	end);
	return U;
end;
