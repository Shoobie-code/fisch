	local function tU(U, P)
		return ((K(U) and math.abs(U) <= P)) and U or nil;
	end;
	local EU = { {
				unit = "scale",
				move = "scaleMove",
				first = "scale0",
				last = "lastScale",
				read = function(U)
					if not U then
						return nil;
