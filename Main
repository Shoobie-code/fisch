local function b(U)
	if type(U) ~= "string" or U == "" then
		return nil;
	end;
	local P = {
			["GuiObject.Position"] = { "FramePositionX" },
			["GuiObject.Size"] = { "FrameSizeX" },
			["GuiObject.Visible"] = { "FrameVisible", "TextLabelVisible" },
			["GuiObject.Rotation"] = { "GuiObjectRotation" },
			["GuiObject.ScreenGui_Enabled"] = { "ScreenGuiEnabled" },
			["ScreenGui.Enabled"] = { "ScreenGuiEnabled" },
			["TextLabel.Text"] = { "TextLabelText" },
			["Instance.Name"] = { "Name" },
			["Instance.ChildrenStart"] = { "Children" },
			["Instance.Parent"] = { "Parent" },
		};
	local m, v = nil, 0;
	for U in ((U .. "\n")):gmatch("([^\n]*)\n") do
		local Y = U:match("namespace%s+([%w_]+)%s*{");
		if Y then
			m = Y;
		end;
		local Q, a = U:match("uintptr_t%s+([%w_]+)%s*=%s*(0x[0-9a-fA-F]+)");
		if Q and a then
			local U = P[((m or "")) .. ("." .. Q)];
			local Y = U and tonumber(a);
			if Y then
				for U, P in ipairs(U) do
					O[P] = Y;
					v = v + 1;
				end;
			end;
		end;
	end;
	return v;
end;
