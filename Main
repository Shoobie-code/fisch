				read = function(U)
					if not U then
						return nil;
					end;
					local P = A((U + Q.FramePositionX) + 4);
					return (math.abs(P) <= 4000) and P or nil;
				end,
			}, {
				unit = "rot",
				move = "rotMove",
				first = "rot0",
				last = "lastRot",
				read = function(U)
					if not U then
						return nil;
					end;
					return tU(O(U + Q.FrameRotation), 360.0);
				end,
			} };
	local uU = {};
	for U, P in ipairs(EU) do
		uU[P.unit] = P;
	end;
	local rU = {
			gui = nil,
			guiAddr = nil,
			guiClass = nil,
			at = 0,
			deepAt = 0,
			kids = nil,
			nestIdx = 0,
			ignoredAddr = nil,
		};
	local function wU(U)
		local P = (tostring(U or "")):lower();
		for U, m in ipairs(nU) do
			if P:find(m, 1, true) then
				return true;
			end;
		end;
		return false;
	end;
	local function IU(U, P)
		if not P and (U - rU.at) < v.nuke then
			return;
		end;
		if rU.gui and (U - rU.at) > 1000 then
			rU.gui, rU.guiAddr, rU.guiClass = nil, nil, nil;
		end;
		rU.at = U;
		local m = q(U);
		if not m then
			rU.gui, rU.guiAddr, rU.guiClass = nil, nil, nil;
			return;
		end;
		local Y = V(m, "NukeMinigame");
		if not Y and rU.gui then
			local U, P = pcall(M, rU.gui, "Parent");
			if U and P then
				Y = rU.gui;
			end;
		end;
		if not Y and ((P or (U - rU.deepAt) >= v.nukeDeep)) then
			rU.deepAt = U;
			rU.kids = j(m);
			for U, P in ipairs(rU.kids) do
				if wU(P.Name) then
					Y = P;
					break;
				end;
			end;
		end;
		local Q = nil;
		if not Y then
			Q = (rU.deepAt == U and rU.kids) or j(m);
		end;
		if not Y and (Q and #Q > 0) then
			for U = 1, math.min(v.nukeNestedPer, #Q), 1 do
				rU.nestIdx = (rU.nestIdx % #Q) + 1;
				for U, P in ipairs(j(Q[rU.nestIdx])) do
					if wU(P.Name) then
						Y = P;
						break;
					end;
				end;
				if Y then
					break;
				end;
			end;
		end;
		if Y then
			local U = l(Y);
			if rU.ignoredAddr and U == rU.ignoredAddr then
				rU.gui, rU.guiAddr, rU.guiClass = nil, nil, nil;
				return;
			end;
			rU.gui, rU.guiAddr, rU.guiClass = Y, U, Y.ClassName;
		else
			rU.gui, rU.guiAddr, rU.guiClass = nil, nil, nil;
			rU.ignoredAddr = nil;
		end;
	end;
	local function dU(U)
		IU(U);
		if not rU.gui then
			return false;
		end;
		if rU.guiClass == "ScreenGui" then
			return i(rU.gui, rU.guiAddr);
		end;
		return R(rU.gui, rU.guiAddr);
	end;
	local function SU(U)
		local P = {};
		local m = l(U);
		local v, Y = { { inst = U, addr = m } }, 1;
		while Y <= #v and ((#P < 48 and Y <= 128)) do
			local U = v[Y];
			Y = Y + 1;
			for m, Y in ipairs(j(U.inst)) do
				local Q = Y.ClassName;
				local a = l(Y);
				if a then
					if sU[Q] then
						local m = {
								inst = Y,
								addr = a,
								parent = U.inst,
								parentAddr = U.addr,
							};
						for U, P in ipairs(EU) do
							m[P.move] = .0;
						end;
						P[#P + 1] = m;
					end;
					v[#v + 1] = { inst = Y, addr = a };
				end;
			end;
		end;
		return P;
	end;
	local zU = { lines = {}, startAt = tick() * 1000, lastWriteAt = 0 };
	local function FU(U)
		local P = ((tick() * 1000 - zU.startAt)) / 1000.0;
		zU.lines[#zU.lines + 1] = string.format("%9.2fs  %s", P, U);
		while #zU.lines > 800 do
			table.remove(zU.lines, 1);
		end;
	end;
	local function pU()
		if type(writefile) ~= "function" then
			return;
		end;
		pcall(writefile, "nuke_log.txt", table.concat(zU.lines, "\n"));
	end;
	local UH = {
			gui = nil,
			candidates = {},
			locked = nil,
			unit = "scale",
			target = .0,
			halfRange = .5,
			deadzone = .05,
			beganAt = 0,
			sampleStart = 0,
			lastTapAt = 0,
			lastPos = nil,
			lastMoveAt = 0,
			warned = false,
			invalids = 0,
			taps = 0,
			marker = nil,
			markerAddr = nil,
			lastStatusAt = 0,
		};
	function UH.Begin(U, P, m)
		U.gui = P;
		U.locked = nil;
		U.beganAt = m;
		U.sampleStart = m;
		U.lastTapAt = 0;
		U.lastPos = nil;
		U.lastMoveAt = m;
		U.warned = false;
		U.invalids = 0;
		U.taps = 0;
		U.lastStatusAt = 0;
		local v = V(P, "Center");
		local Y = v and V(v, "Marker");
		U.marker = Y;
		U.markerAddr = l(Y);
		U.candidates = SU(P);
		FU(string.format("begin: candidates=%d markerAddr=%s", #U.candidates, tostring(U.markerAddr)));
	end;
	function UH.Sample(U)
		for U, P in ipairs(U.candidates) do
			for U, m in ipairs(EU) do
				local v = m.read(c(P.inst, P.addr));
				if v then
					local U = P[m.last];
					if U ~= nil then
						P[m.move] = P[m.move] + math.abs(v - U);
					end;
					if P[m.first] == nil then
						P[m.first] = v;
					end;
					P[m.last] = v;
				end;
			end;
		end;
	end;
	function UH.TryLock(P, m)
		if (m - P.sampleStart) < 250 then
			return;
		end;
		local v, Y, a = nil, .0, nil;
		local C = c(P.marker, P.markerAddr);
		for U, P in ipairs(P.candidates) do
			local m = c(P.parent, P.parentAddr);
			local K = m and math.abs(A((m + Q.FrameSizeX) + 4)) or 0;
			local G = (P.offMove > 1) and (P.offMove / math.max(80, K)) or .0;
			local L = P.rotMove / 90.0;
			local O, b = "scale", P.scaleMove;
			if G > b then
				O, b = "offset", G;
			end;
			if L > b then
				O, b = "rot", L;
			end;
			if C and P.addr == C then
				b = b * 2.0;
			end;
			if b > Y then
				v, Y, a = P, b, O;
			end;
		end;
		if not v or Y < .004 then
			return;
		end;
		P.locked = v;
		P.unit = a;
		if a == "scale" then
			P.target = ((C and v.addr == C)) and .5 or (v.scale0 or .5);
			P.halfRange = .5;
		elseif a == "offset" then
			local U = c(v.parent, v.parentAddr);
			local m = U and math.abs(A((U + Q.FrameSizeX) + 4)) or 0;
			P.target = v.off0 or .0;
			P.halfRange = (m > 40) and (m / 2) or 200;
		else
			P.target = v.rot0 or .0;
			P.halfRange = 30.0;
		end;
		P.deadzone = U.nukeDeadzoneFrac * P.halfRange;
		P.lastPos = nil;
		P.lastMoveAt = m;
		FU(string.format("lock: unit=%s marker=%s target=%.3f range=%.1f score=%.4f", P.unit, tostring(C ~= nil and v.addr == C), P.target, P.halfRange, Y));
	end;
	function UH.ReadPos(U)
		return uU[U.unit].read(c(U.locked.inst, U.locked.addr));
	end;
	function UH.Update(P, m)
		if (m - zU.lastWriteAt) >= 2000 then
			zU.lastWriteAt = m;
			pU();
		end;
		if not P.locked then
			P:Sample();
			P:TryLock(m);
			if not P.locked and ((not P.warned and (m - P.beganAt) > 4000)) then
				P.warned = true;
				FU("no mover found after 4s");
			end;
			return;
		end;
		local v = P:ReadPos();
		if v == nil then
			P.invalids = P.invalids + 1;
			if P.invalids > 30 and P.gui then
				FU("locked read went invalid, rescanning");
				P:Begin(P.gui, m);
			end;
			return;
		end;
		P.invalids = 0;
		local Y = v - P.target;
		local Q = (P.lastPos ~= nil) and (v - P.lastPos) or .0;
		P.lastPos = v;
		if math.abs(Q) > (P.halfRange * .0005) then
			P.lastMoveAt = m;
		end;
		if (m - P.lastMoveAt) > 1500 then
			FU("locked element static for 1.5s, rescanning");
			P.locked = nil;
			P.candidates = SU(P.gui);
			P.sampleStart = m;
			return;
		end;
		if (m - P.lastStatusAt) >= 400 then
			P.lastStatusAt = m;
			FU(string.format("pos=%.3f err=%.3f vel=%.4f taps=%d", v, Y, Q, P.taps));
		end;
		local a = Y + (Q * U.nukePrediction);
		if math.abs(a) <= P.deadzone then
			return;
		end;
		if (Y * Q) < 0 and (math.abs(Q) * U.nukePrediction) >= math.abs(Y) then
			return;
		end;
		local C = a > 0;
		local K = math.min(1.0, math.abs(a) / P.halfRange);
		local G = math.max(25, U.nukeTapIntervalMs * ((1.35 - K)));
		if (m - P.lastTapAt) < G then
			return;
		end;
		if I(C and s.Q or s.E, U.nukeTapHoldMs, m) then
			P.lastTapAt = m;
			P.taps = P.taps + 1;
			FU(string.format("tap %s err=%.3f pred=%.3f vel=%.4f", C and "Q" or "E", Y, a, Q));
		end;
	end;
	local function PH(U)
		DU();
		bU();
		w();
		FU(string.format("EXIT success=%s taps=%d after=%.1fs", tostring(U), UH.taps, ((tick() * 1000 - UH.beganAt)) / 1000.0));
		pU();
		if U then
			xU.nukes = xU.nukes + 1;
			print("Nuke survived (" .. (xU.nukes .. " total)"));
		end;
		xU.lastReelCaught = false;
		xU.doneAt = 0;
		xU.phase = "DONE";
	end;
	local function mH(P)
		bU();
		if not dU(P) then
			PH(true);
			return;
		end;
		if (P - UH.beganAt) > U.nukeTimeoutMs then
			rU.ignoredAddr = rU.guiAddr;
			PH(false);
			return;
		end;
		if not UH.locked and (P - UH.beganAt) > U.nukeLockTimeoutMs then
			FU("no mover found, treating this GUI as a false positive");
			rU.ignoredAddr = rU.guiAddr;
			PH(false);
			return;
		end;
		UH:Update(P);
	end;
	local vH = {
			gui = nil,
			guiAddr = nil,
			guiClass = nil,
			at = 0,
			ignoredAddr = nil,
			running = false,
			startedAt = 0,
			pending = nil,
			releaseAt = 0,
			nextPressAt = 0,
			right = false,
			taps = 0,
		};
	local function YH(P, m)
		if not m and (P - vH.at) < v.stab then
			return;
		end;
		vH.at = P;
		local Y = q(P);
		local Q = Y and V(Y, U.stabGuiName) or nil;
		if not Q then
			vH.gui, vH.guiAddr, vH.guiClass = nil, nil, nil;
			vH.ignoredAddr = nil;
			return;
		end;
		local a, C = pcall(M, Q, "ClassName");
		vH.gui, vH.guiAddr = Q, l(Q);
		vH.guiClass = (a and C) or nil;
	end;
	local function QH(U)
		YH(U);
		if not vH.gui then
			return false;
		end;
		if vH.ignoredAddr and vH.guiAddr == vH.ignoredAddr then
			return false;
		end;
		if vH.guiClass == "ScreenGui" then
			return i(vH.gui, vH.guiAddr);
		end;
		return R(vH.gui, vH.guiAddr);
	end;
	local aH = false;
	local function CH()
		local U = vH.pending;
		vH.pending = nil;
		if U == 2 then
			OU();
		elseif U == 1 then
			GU();
		end;
	end;
	local function KH(P)
		local m = ((vH.right and mU)) and 2 or 1;
		if vH.pending then
			if P < vH.releaseAt then
				return;
			end;
			local U = vH.pending;
			CH();
			if U == m then
				return;
			end;
		end;
		if P < vH.nextPressAt then
			return;
		end;
		local v = m == 2;
		if vH.right and (not mU and not aH) then
			aH = true;
		end;
		if v then
			vH.pending = 2;
			LU();
		else
			vH.pending = 1;
			KU();
		end;
		vH.taps = vH.taps + 1;
		vH.right = not vH.right;
		vH.releaseAt = P + U.stabHoldMs;
		vH.nextPressAt = P + U.stabIntervalMs;
	end;
	local function GH(P)
		vH.running = true;
		vH.startedAt = P;
		vH.taps = 0;
		vH.pending = nil;
		vH.releaseAt = 0;
		vH.nextPressAt = 0;
		vH.right = U.stabStartRight and true or false;
		bU();
	end;
	local function LH(U, P)
		vH.running = false;
		vH.pending = nil;
		bU();
		if P then
			xU.stabs = xU.stabs + 1;
		end;
	end;
	local function OH(P)
		if not PU() then
			if vH.pending then
				CH();
			end;
			return;
		end;
		local m = QH(P);
		if m then
			if not vH.running then
				GH(P);
			end;
		elseif vH.running then
			LH(P, true);
			return;
		else
			return;
		end;
		if (P - vH.startedAt) > U.stabTimeoutMs then
			vH.ignoredAddr = vH.guiAddr;
			LH(P, false);
			return;
		end;
		KH(P);
	end;
	local function bH(U)
		U = U or (tick() * 1000);
		return xU.reelClosedAt > 0 and (U - xU.reelClosedAt) < 700;
	end;
	local function hH()
		DU();
		bU();
		local P = tick() * 1000;
		xU.castStartedAt = P;
		xU.castPressAt = 0;
		xU.castReleasedAt = 0;
		xU.castBarSeen = false;
		xU.castArmed = false;
		xU.reelDownSeen = false;
		xU.castChargeLastPct = nil;
		xU.castChargeMotionAt = 0;
		xU.shakeStartedAt = 0;
		xU.lastShakedAt = 0;
		xU.shakeCount = 0;
		xU.shakeSeen = false;
		xU.shakeUnstickAt = 0;
		xU.maxProgress = 0;
		xU.reelStartedAt = 0;
		xU.reelMotionAt = 0;
		xU.reelSignature = nil;
		xU.reelRecovered = false;
		xU.reelDone = {};
		xU.reelDoneCount = 0;
		xU.doneAt = 0;
		xU.castThreshold = qU();
		xU.castWaitTimeoutMs = math.max(5000, U.castTimeoutMs);
		xU.shakingIntervalMs = U.shakeIntervalMs;
		B(P, true);
		x(P, true);
		H.powerAt = 0;
		local m = bH(P);
		xU.phase = ((J(P) and not m)) and "FISHING" or (((n(P) and not m)) and "SHAKE" or "CASTING");
		xU.shakeSeen = xU.phase == "SHAKE";
		if U.mode == "rod" and (xU.phase == "CASTING" and TU() == false) then
			iU(P);
		end;
	end;
	local function AH(U)
		DU();
		bU();
		y.slots = {};
		y.at = 0;
		xU.phase = U or "OFF";
	end;
	local function MH(P, m)
		xU.timeouts = xU.timeouts + 1;
		if m and (U.reequipOnDeadCast and not xU.castEverSeen) then
			AH("OFF");
			iU(P);
			return;
		end;
		if U.castOnTimeout then
			hH();
		else
			AH("OFF");
		end;
	end;
	local function lH(P)
		if not J(P) then
			xU.reelDownSeen = true;
		elseif xU.reelDownSeen and not bH(P) then
			GU();
			xU.castEverSeen = true;
			xU.phase = "FISHING";
			return;
		end;
		if n(P) and not bH(P) then
			GU();
			xU.castEverSeen = true;
			xU.lastShakedAt = 0;
			xU.shakeSeen = true;
			if xU.castReleasedAt == 0 then
				xU.castReleasedAt = P;
			end;
			xU.phase = "SHAKE";
			return;
		end;
		if xU.castStartedAt == 0 then
			xU.castStartedAt = P;
		end;
		if not vU then
			if (P - xU.castPressAt) >= U.castRepressGapMs then
				KU();
				xU.castPressAt = P;
			end;
		elseif not xU.castBarSeen and (P - xU.castPressAt) >= U.castRepressMs then
			GU();
			xU.castPressAt = P;
		end;
		local m = ZU(P);
		if not m then
			local U = P - xU.castStartedAt;
			if not xU.castBarSeen and U >= 2000 then
				MH(P, true);
				return;
			end;
			if U >= xU.castWaitTimeoutMs then
				MH(P);
			end;
			return;
		end;
		xU.castBarSeen = true;
		xU.castEverSeen = true;
		local v = HU(m);
		if v then
			if not xU.castArmed and v < xU.castThreshold then
				xU.castArmed = true;
			end;
			if xU.castArmed and v >= xU.castThreshold then
				GU();
				xU.castReleasedAt = P;
				xU.phase = "CASTED";
				return;
			end;
		else
			H.powerAt = 0;
		end;
		local Y = (v ~= nil) and ((xU.castChargeLastPct == nil or math.abs(v - xU.castChargeLastPct) >= .5));
		if Y then
			xU.castChargeMotionAt = P;
		end;
		xU.castChargeLastPct = v;
		if xU.castChargeMotionAt == 0 then
			xU.castChargeMotionAt = P;
		end;
		if xU.castBarSeen and (P - xU.castChargeMotionAt) >= 1200 then
			MH(P);
			return;
		end;
		if (P - xU.castStartedAt) >= xU.castWaitTimeoutMs then
			MH(P);
		end;
	end;
	local function TH(P)
		bU();
		if xU.castReleasedAt == 0 then
			xU.castReleasedAt = P;
		end;
		if (P - xU.castReleasedAt) < U.postCastDelayMs then
			return;
		end;
		xU.lastShakedAt = 0;
		xU.phase = "SHAKE";
	end;
	local function cH(P)
		bU();
		if J(P) and (not bH(P) and (P - xU.castReleasedAt) >= 400) then
			xU.phase = "FISHING";
			return;
		end;
		if xU.shakeStartedAt == 0 then
			xU.shakeStartedAt = P;
		end;
		if xU.shakeUnstickAt == 0 then
			xU.shakeUnstickAt = P;
		elseif (P - xU.shakeUnstickAt) >= 1500 then
			xU.shakeUnstickAt = P;
			if not t[s.Enter] then
				keyrelease(s.Enter);
			end;
		end;
		if xU.lastShakedAt == 0 or (P - xU.lastShakedAt) >= xU.shakingIntervalMs then
			if d() then
				xU.shakeCount = xU.shakeCount + 1;
				xU.lastShakedAt = P;
			end;
		end;
		if not xU.shakeSeen and n(P) then
			xU.shakeSeen = true;
		end;
		if not xU.shakeSeen and (P - xU.shakeStartedAt) >= U.castLandTimeoutMs then
			xU.timeouts = xU.timeouts + 1;
			hH();
			return;
		end;
		if (P - xU.shakeStartedAt) >= U.shakeTimeoutMs then
			hH();
		end;
	end;
	local function eH(U)
		DU();
		bU();
		xU.reelClosedAt = tick() * 1000;
		if U then
			local U = math.max(1, xU.reelDoneCount);
			xU.caught = xU.caught + U;
			xU.lastReelCaught = true;
			print("Caught " .. ((((U > 1) and (U .. " at once ") or "")) .. ("(" .. (xU.caught .. " total)"))));
		else
			xU.lost = xU.lost + 1;
			xU.lastReelCaught = false;
		end;
		AH("DONE");
	end;
	local function iH(P, m)
		if xU.reelStartedAt == 0 then
			xU.reelStartedAt = P;
			xU.reelMotionAt = P;
		end;
		if not ((m or (((y.driven[1] or y.driven[2])) and (P - v.bookAt) < v.book))) then
			v.bookAt = P;
			B(P, WU[1] == nil and WU[2] == nil);
			local m = {};
			for U, P in ipairs(y.slots) do
				if D(P) then
					m[#m + 1] = P;
				end;
			end;
			if #m == 0 then
				eH(xU.maxProgress >= U.completionThreshold);
				return;
			end;
			local Y = {};
			for U, P in ipairs(m) do
				Y[P.barAddr] = true;
			end;
			for U = 1, #NU, 1 do
				local P = WU[U];
				if P and not Y[P] then
					oU(U);
				end;
			end;
			local Q = U.dualReel and #NU or 1;
			local a = {};
			for U, P in ipairs(m) do
				local m = gU(P.barAddr);
				if not m then
					for U = 1, Q, 1 do
						if WU[U] == nil then
							m = U;
							WU[U] = P.barAddr;
							NU[U].ctrl:Reset();
							if U > 1 and not mU then
								JU();
							end;
							break;
						end;
					end;
				end;
				if m then
					a[m] = P;
				end;
			end;
			local C = true;
			local K = "";
			for P = 1, #NU, 1 do
				local m = a[P];
				y.driven[P] = m;
				if not m then
					NU[P].release();
				else
					local v = jU(c(m.progressBar, m.progressAddr));
					if v then
						if v > xU.maxProgress then
							xU.maxProgress = v;
						end;
						if v < U.completionThreshold then
							C = false;
						elseif not xU.reelDone[m.barAddr] then
							xU.reelDone[m.barAddr] = true;
							xU.reelDoneCount = xU.reelDoneCount + 1;
						end;
					else
						C = false;
					end;
					if ((m.readAt or 0)) > 0 then
						K = K .. string.format("|%d,%.4f,%.4f,%.2f", P, m.readFish, m.readBar, v or -1.0);
					else
						C = false;
					end;
				end;
			end;
			if K ~= xU.reelSignature then
				xU.reelSignature = K;
				xU.reelMotionAt = P;
			end;
			if C then
				eH(true);
				return;
			end;
			if (P - xU.reelMotionAt) >= U.reelStallMs then
				xU.reelMotionAt = P;
				xU.reelSignature = nil;
				DU();
				bU();
				B(P, true);
				return;
			end;
			if U.reelTimeoutMs > 0 and (P - xU.reelStartedAt) >= U.reelTimeoutMs then
				xU.timeouts = xU.timeouts + 1;
				eH(xU.maxProgress >= U.completionThreshold);
				return;
			end;
		end;
		local Y = y.driven;
		for U = 1, #NU, 1 do
			local m = Y[U];
			if m then
				local v = c(m.fish, m.fishAddr);
				local Y = c(m.playerbar, m.playerbarAddr);
				if not ((v and Y)) then
					m.fish = V(m.bar, "fish") or m.fish;
					m.playerbar = V(m.bar, "playerbar") or m.playerbar;
					v = c(m.fish, m.fishAddr);
					Y = c(m.playerbar, m.playerbarAddr);
				end;
				if v and Y then
					m.fishAddr, m.playerbarAddr = v, Y;
					local a = O(v + Q.FramePositionX) + (O(v + Q.FrameSizeX) * .5);
					local C = O(Y + Q.FramePositionX);
					local G = O(Y + Q.FrameSizeX);
					if K(G) and G >= .001 then
						m.readFish, m.readBar, m.readAt = a, C, P;
						NU[U].ctrl:Update(a, C, G);
					else
						m.readAt = 0;
						NU[U].release();
					end;
				else
					m.readAt = 0;
					NU[U].release();
				end;
			end;
		end;
	end;
	local function RH(P)
		if J(P) and not bH(P) then
			xU.doneAt = 0;
			xU.phase = "FISHING";
			return;
		end;
		if xU.doneAt == 0 then
			xU.doneAt = P;
		end;
		local m = xU.lastReelCaught and U.postCatchDelayMs or U.postLostDelayMs;
		if (P - xU.doneAt) < m then
			return;
		end;
		hH();
	end;
	local VH = {
			CASTING = lH,
			CASTED = TH,
			SHAKE = cH,
			FISHING = iH,
			DONE = RH,
			NUKE = mH,
		};
	local jH = false;
	local function ZH(P)
		P = P and true or false;
		if P == jH then
			return;
		end;
		jH = P;
		if P then
			xU.phase = "OFF";
			xU.reelClosedAt = 0;
			y.ignored = {};
			CU = tick() * 1000;
			if type(setrobloxinput) == "function" then
				pcall(setrobloxinput, true);
			end;
			xU.castEverSeen = false;
			eU.done = true;
			if U.mode == "rod" then
				hH();
				if xU.phase == "CASTING" then
					xU.phase = "OFF";
					iU(tick() * 1000);
				end;
			end;
		else
			DU();
			bU();
			xU.phase = "OFF";
		end;
	end;
	local function HH(m)
		local v = P[m];
		if not v or v == U.mode then
			return false;
		end;
		if jH then
			ZH(false);
		end;
		U.mode = v;
		return true;
	end;
	local qH = { inset = 0 };
	local yH = nil;
	local function XH()
		local U = yH;
		if not U then
			local P = W();
			if not P then
				return nil;
			end;
			local m, v = pcall(P.GetMouse, P);
			if not m or not v then
				return nil;
			end;
			yH = v;
			U = v;
		end;
		local P, m = U.X, U.Y;
		if not ((P and m)) then
			yH = nil;
			return nil;
		end;
		return P, m + qH.inset;
	end;
	local fH = {};
	local function kH(U)
		local P = iskeypressed(U) and true or false;
		local m = P and not fH[U];
		fH[U] = P;
		return m;
	end;
	local NH = nil;
	local WH = 0;
	local function oH(P)
		if xU.phase ~= NH then
			NH = xU.phase;
			WH = P;
			return;
		end;
		if (P - WH) < U.stuckTimeoutMs and (P - CU) < U.stuckTimeoutMs then
			return;
		end;
		WH = P;
		CU = P;
		xU.recoveries = ((xU.recoveries or 0)) + 1;
		DU();
		bU();
		w();
		vU, YU = false, false;
		QU, aU = true, true;
		pcall(mouse1release);
		if mU then
			pcall(mouse2release);
		end;
		if type(setrobloxinput) == "function" then
			pcall(setrobloxinput, true);
		end;
		eU.done = true;
		y.ignored = {};
		hH();
		NH = xU.phase;
	end;
	local function DH(U)
		if not PU() then
			bU();
			if xU.reelStartedAt > 0 then
				xU.reelStartedAt = U;
				xU.reelMotionAt = U;
			end;
			WH, CU = U, U;
			return;
		end;
		oH(U);
		if not RU(U) then
			return;
		end;
		if YU and xU.phase ~= "FISHING" then
			OU();
		end;
		if xU.phase == "OFF" then
			hH();
		end;
		if xU.phase ~= "NUKE" and (U - v.crossAt) >= v.cross then
			v.crossAt = U;
			if not J(U) and dU(U) then
				FU("ENTER from phase=" .. (tostring(xU.phase) .. (" guiAddr=" .. tostring(rU.guiAddr))));
				DU();
				bU();
				w();
				UH:Begin(rU.gui, U);
				xU.phase = "NUKE";
			end;
		end;
		for P = 1, 4, 1 do
			local m = xU.phase;
			local v = VH[m];
			if not v then
				break;
			end;
			v(U);
			if xU.phase == m then
				break;
			end;
		end;
	end;
	local BH = { ImageButton = true, TextButton = true };
	local JH = { pull = true, darkpull = true };
	local gH = { buttonTemplates = true };
	local xH = {
			stage = "SEEK",
			actAt = 0,
			calX = 0,
			calY = 0,
			fixes = 0,
			wantAddr = nil,
			pressedAt = 0,
			aimX = 0,
			aimY = 0,
			lastAddr = nil,
			lastAt = 0,
			gui = nil,
			guiAt = 0,
			warnedNoMove = false,
			warnedNoGui = false,
		};
	local function nH(U)
		if not U then
			return nil;
		end;
		local P = O(U + Q.AbsoluteSizeX);
		local m = O(U + Q.AbsoluteSizeY);
		if not ((((P > 4 and m > 4)) and ((P < 8000 and m < 8000)))) then
			return nil;
		end;
		local v = O(U + Q.AbsolutePositionX);
		local Y = O(U + Q.AbsolutePositionY);
		if not ((K(v) and K(Y))) then
			return nil;
		end;
		return v, Y, P, m;
	end;
	local function sH(U)
		local P, m, v = nil, nil, math.huge;
		local Y, Q = { U }, 1;
		while Q <= #Y and Q <= 64 do
			local U = Y[Q];
			Q = Q + 1;
			for U, Q in ipairs(j(U)) do
				local a = Q.Name;
				if not gH[a] then
					local U = l(Q);
					if U and R(Q, U) then
						if JH[a] and BH[Q.ClassName] then
							local Y, Q, a, C = nH(U);
							if Y and (a * C) < v then
								P, v = U, a * C;
								m = {
										cx = Y + (a * .5),
										cy = Q + (C * .5),
										x = Y,
										y = Q,
										w = a,
										h = C,
									};
							end;
						end;
						if #Y < 64 then
							Y[#Y + 1] = Q;
						end;
					end;
				end;
			end;
		end;
		return P, m;
	end;
	local function tH(P)
		if xH.gui and ((P - xH.guiAt) < v.gun and T(xH.gui)) then
			return xH.gui;
		end;
		xH.guiAt = P;
		local m = q(P);
		xH.gui = m and V(m, U.gunGuiName) or nil;
		return xH.gui;
	end;
	local function EH(U)
		xH.aimX, xH.aimY = U.cx, U.cy;
		AU(U.cx + xH.calX, U.cy + xH.calY);
	end;
	local function uH(P)
		xH.pressedAt = P;
		KU();
		xH.stage = "HOLD";
		xH.actAt = P + U.gunHoldMs;
	end;
	local function rH(P)
		if not PU() then
			GU();
			xH.stage = "SEEK";
			return;
		end;
		if not hU then
			if not xH.warnedNoMove then
				xH.warnedNoMove = true;
				notify("mousemoveabs() is missing - Gun mode cannot aim.", "", 6);
			end;
			return;
		end;
		local m = tH(P);
		if not m then
			if not xH.warnedNoGui then
				xH.warnedNoGui = true;
			end;
			GU();
			xH.stage = "SEEK";
			return;
		end;
		xH.warnedNoGui = false;
		local v, Y = sH(m);
		if xH.stage == "HOLD" then
			if Y and v == xH.wantAddr then
				EH(Y);
			end;
			if P >= xH.actAt then
				GU();
				xH.lastAddr, xH.lastAt = xH.wantAddr, P;
				xH.stage = "SEEK";
			end;
			return;
		end;
		if xH.stage == "AIM" then
			if not v then
				xH.stage = "SEEK";
				return;
			end;
			xH.wantAddr = v;
			if P >= xH.actAt then
				local m, v = XH();
				if not ((m and v)) then
					uH(P);
					return;
				end;
				if ((m >= Y.x and m <= (Y.x + Y.w))) and ((v >= Y.y and v <= (Y.y + Y.h))) then
					uH(P);
					return;
				end;
				if xH.fixes >= U.gunMaxFixes then
					uH(P);
					return;
				end;
				xH.calX = xH.calX + ((xH.aimX - m));
				xH.calY = xH.calY + ((xH.aimY - v));
				xH.fixes = xH.fixes + 1;
			end;
			EH(Y);
			return;
		end;
		if not v then
			return;
		end;
		if v == xH.lastAddr and (P - xH.lastAt) < U.gunRearmMs then
			return;
		end;
		if xH.pressedAt > 0 and (P - xH.pressedAt) < U.gunDelayMs then
			return;
		end;
		xH.wantAddr = v;
		xH.fixes = 0;
		EH(Y);
		xH.stage = "AIM";
		xH.actAt = P + U.gunSettleMs;
	end;
	local wH = { rod = DH, spear = OH, gun = rH };
	local function IH()
		local P = tick() * 1000;
		r(P);
		if not jH then
			return;
		end;
		if U.mode == "rod" and (xU.phase == "FISHING" and (P - v.steerAt) >= v.steer) then
			v.steerAt = P;
			if not pcall(iH, P, true) then
				bU();
			end;
		end;
		if (P - v.stepAt) < v.step then
			return;
		end;
		v.stepAt = P;
		local m = wH[U.mode];
		if not m then
			return;
		end;
		if not pcall(m, P) then
			bU();
		end;
	end;
	o.CONFIG = U;
	o.TUNING = yU;
	o.STATE = xU;
	o.probe = function()
			return xU, vU;
		end;
	o.MODES = P;
	o.REFRESH = v;
	o.setEnabled = ZH;
	o.setMode = HH;
	o.fastBody = IH;
	o.isEnabled = function()
			return jH;
		end;
	o.modeLabel = m;
	o.flushKeys = w;
	o.tapKey = I;
	o.pumpKeys = r;
	o.keysOwed = function()
			return next(t) ~= nil;
		end;
	o.releaseAll = bU;
	o.unbindReels = DU;
	o.reelActive = J;
	o.shakeUp = n;
	o.castThreshold = qU;
	o.holdingRod = cU;
end;
local D, B, J;
local g = false;
local x = false;
local n = { Enter = 13, E = 69 };
local s = o.STATE;
C.probe = o.probe;
s.running = false;
s.rod = "";
s.recoveries = s.recoveries or 0;
local t = {
		OFF = "idle",
		CASTING = "casting",
		CASTED = "casting",
		SHAKE = "shaking",
		FISHING = "reeling",
		DONE = "done",
		NUKE = "nuke",
		STAB = "spear",
	};
local function E()
	pcall(o.releaseAll);
end;
local function u(U, P)
	pcall(o.tapKey, U, P, tick() * 1000);
end;
local r = { autofishFallback = 112 };
local function w(U)
	if type(iskeypressed) ~= "function" then
		return false;
	end;
	local P, m = pcall(iskeypressed, U);
	return ((P and m)) and true or false;
end;
local I = {};
local function d(U)
	local P = w(U);
	local m = P and not I[U];
	I[U] = P;
	return m;
end;
C.hotkeyEdge = d;
local function S()
	local U, P = pcall(o.reelActive, tick() * 1000);
	return U and P or false;
end;
C.releaseKeys = function()
		pcall(o.setEnabled, false);
		pcall(o.unbindReels);
		pcall(o.flushKeys);
		pcall(o.releaseAll);
	end;
local function z(U)
	U = U and true or false;
	if U == s.running then
		return;
	end;
	s.running = U;
	pcall(o.setEnabled, U);
	if not U then
		E();
	end;
	local P = U and "Auto Fish on" or ("Auto Fish off (" .. (tostring(s.caught or 0) .. " caught)"));
	if D then
		pcall(function()
			D:Notify(P, 2);
		end);
	else
		notify(P, "", 2);
	end;
	if J and not g then
		g = true;
		pcall(function()
			J:Set(U);
		end);
		g = false;
	end;
end;
local function F()
	local U = s.running and ((t[s.phase] or tostring(s.phase))) or "idle";
	if U == "casting" then
		return string.format("state(casting) threshold(%.0f%%) seen(%s) armed(%s)", s.castThreshold or 0, tostring(s.castBarSeen), tostring(s.castArmed));
	elseif U == "shaking" then
		return string.format("state(shaking) shook=(%d)", s.shakeCount or 0);
	elseif U == "reeling" then
		return string.format("state(reeling) progress(%.1f) bars(%d)", s.maxProgress or 0, s.reelDoneCount or 0);
	elseif U == "nuke" then
		return "state(nuke)";
	end;
	return "state(" .. (U .. ")");
end;
local p = 540000;
local UU = tick() * 1000;
local function PU()
	if s.running then
		UU = tick() * 1000;
		return;
	end;
	if not N() then
		return;
	end;
	if (tick() * 1000 - UU) >= p then
		UU = tick() * 1000;
		u(126, 20);
	end;
end;
local function mU(U)
	local P = H(U, "zonename");
	if P then
		local U, m = pcall(function()
				return P.Value;
			end);
		if U and (type(m) == "string" and m ~= "") then
			return m;
		end;
	end;
	return U.Name;
end;
local function vU(U, P)
	local m = H(Q, "zones");
	local function v(v)
		for m, v in ipairs(q(H(m, v))) do
			local Y, Q = pcall(function()
					return v.Position;
				end);
			if Y and typeof(Q) == "Vector3" then
				local m = mU(v);
				if P and P[m] == nil then
					P[m] = Q;
				end;
				if U then
					local P = false;
					for U, v in ipairs(U) do
						if v.name == m then
							P = true;
							break;
						end;
					end;
					if not P then
						U[#U + 1] = { name = m, pos = Q };
					end;
				end;
			end;
		end;
	end;
	v("player");
	if L.wp_include_fishing then
		v("fishing");
	end;
	return U, P;
end;
local function YU()
	local U = {};
	local P = H(Q, "world");
	for P, m in ipairs({ H(P, "chests"), H(P, "ActiveChestsFolder") }) do
		for P, m in ipairs(q(m)) do
			local v, Y = pcall(function()
					return m.Position;
				end);
			if v and typeof(Y) == "Vector3" then
				U[#U + 1] = { name = m.Name, pos = Y };
			end;
		end;
	end;
	return U;
end;
local function QU(U, P)
	if pcall(function()
		U.Size = P;
	end) then
		return;
	end;
	pcall(function()
		U.FontSize = P;
	end);
end;
local aU = {
		hrp = nil,
		at = -1000000000.0,
		readAt = -1000000000.0,
		x = nil,
		y = nil,
		z = nil,
	};
function aU.read(U)
	if U - aU.readAt < 5 then
		return aU.x ~= nil;
	end;
	aU.readAt = U;
	local P = aU.hrp;
	if P and U - aU.at >= 1000 then
		P = nil;
	end;
	if P then
		local U, m = pcall(function()
				return P.Parent;
			end);
		if not ((U and m ~= nil)) then
			P = nil;
		end;
	end;
	if not P and U - aU.at >= ((aU.hrp == nil and 250 or 0)) then
		P = f();
		aU.hrp, aU.at = P, U;
	end;
	aU.x, aU.y, aU.z = nil, nil, nil;
	if P then
		local U, m = pcall(function()
				return P.Position;
			end);
		if U and m then
			aU.x, aU.y, aU.z = m.X, m.Y, m.Z;
		end;
	end;
	return aU.x ~= nil;
end;
local function CU(U)
	local P = {
			objects = {},
			conn = nil,
			shown = false,
			list = {},
			lastScan = 0,
		};
	local function m(m)
		while #P.objects < m do
			local m = C.draw("Square");
			m.Filled = true;
			m.Color = U.color;
			m.Visible = false;
			local v = C.draw("Text");
			v.Color = U.textColor;
			v.Center = true;
			v.Outline = true;
			v.Visible = false;
			P.objects[#P.objects + 1] = { sq = m, tx = v, vis = false };
		end;
	end;
	function P.rescan()
		P.lastScan = 0;
	end;
	function P.hide()
		P.shown = false;
		if P.conn then
			pcall(function()
				P.conn:Disconnect();
			end);
			P.conn = nil;
		end;
		for U, P in ipairs(P.objects) do
			pcall(function()
				P.sq.Visible = false;
				P.tx.Visible = false;
			end);
			P.vis = false;
		end;
	end;
	function P.show()
		if P.shown then
			return;
		end;
		P.shown = true;
		P.lastScan = 0;
		P.conn = C.track(v.Heartbeat:Connect(function()
				local v = tick() * 1000;
				if v - ((P.drawAt or 0)) < 33 then
					return;
				end;
				P.drawAt = v;
				if P.lastScan == 0 or (v - P.lastScan) >= ((U.rescan and L[U.rescan] or 5000)) then
					P.lastScan = v;
					P.list = U.collect();
					for U, P in ipairs(P.list) do
						P.x, P.y, P.z = P.pos.X, P.pos.Y, P.pos.Z;
					end;
				end;
				m(#P.list);
				local Y = aU.read(v);
				local Q, a, C = aU.x, aU.y, aU.z;
				local K, G = L[U.size], L[U.text];
				local O, b = L[U.maxd], L[U.dist];
				local h = K / 2;
				for U, m in ipairs(P.objects) do
					local v, L = P.list[U], false;
					if v then
						local U;
						if Y then
							local P, m, Y = v.x - Q, v.y - a, v.z - C;
							U = math.sqrt((P * P + m * m) + Y * Y);
						end;
						if not ((O > 0 and (U and U > O))) then
							local P, Y = WorldToScreen(v.pos);
							if Y and P then
								local Y, Q = P.X, P.Y;
								if m.size ~= K then
									m.sq.Size = Vector2.new(K, K);
									m.size, m.sx = K, nil;
								end;
								if m.tsize ~= G then
									QU(m.tx, G);
									m.tsize, m.sx = G, nil;
								end;
								if m.sx ~= Y or m.sy ~= Q then
									m.sq.Position = Vector2.new(Y - h, Q - h);
									m.tx.Position = Vector2.new(Y, ((Q - h) - G) - 2);
									m.sx, m.sy = Y, Q;
								end;
								local a = ((b and U)) and math.floor(U) or nil;
								if m.name ~= v.name or m.d ~= a then
									m.tx.Text = a and string.format("%s [%d]", v.name, a) or v.name;
									m.name, m.d = v.name, a;
								end;
								if not m.vis then
									m.sq.Visible = true;
									m.tx.Visible = true;
									m.vis = true;
								end;
								L = true;
							end;
						end;
					end;
					if not L and m.vis then
						m.sq.Visible = false;
						m.tx.Visible = false;
						m.vis = false;
					end;
				end;
			end));
	end;
	return P;
end;
local KU = CU({
		color = Color3.fromRGB(255, 0, 0),
		textColor = Color3.fromRGB(255, 255, 255),
		size = "wp_square_size",
		text = "wp_text_size",
		dist = "wp_show_distance",
		maxd = "wp_max_distance",
		rescan = "wp_rescan_ms",
		collect = function()
			return (vU({}, nil));
		end,
	});
local GU = CU({
		color = Color3.fromRGB(255, 215, 0),
		textColor = Color3.fromRGB(255, 235, 120),
		size = "chest_square_size",
		text = "chest_text_size",
		dist = "chest_show_distance",
		maxd = "chest_max_distance",
		rescan = "chest_rescan_ms",
		collect = function()
			local U = YU();
			for U, P in ipairs(U) do
				P.name = "Chest";
			end;
			return U;
		end,
	});
local LU = { startedSent = false, lastStatsAt = 0 };
function LU.validUrl(U)
	return type(U) == "string" and ((U:find("discord.com/api/webhooks/", 1, true) or U:find("discordapp.com/api/webhooks/", 1, true))) ~= nil;
end;
function LU.post(U)
	if not L.webhook_enabled then
		return false;
	end;
	local P = L.webhook_url;
	if not LU.validUrl(P) then
		return false;
	end;
	local m, v = pcall(function()
			return Y:JSONEncode({ content = U });
		end);
	if not m then
		return false;
	end;
	local Q = pcall(function()
			game:HttpPost(P, v, Enum.HttpContentType.ApplicationJson);
		end);
	if not Q then
		Q = pcall(function()
				game:HttpPost(P, v, false, "application/json");
			end);
	end;
	if not Q then
		Q = pcall(function()
				game:HttpPost(P, v);
			end);
	end;
	return Q;
end;
function LU.sendAsync(U)
	task.spawn(function()
		pcall(LU.post, U);
	end);
end;
function LU.leaderstat(U)
	local P = H(a(), "leaderstats");
	if not P then
		return nil;
	end;
	for U, m in ipairs(U) do
		local v = H(P, m);
		if v then
			local U, P = pcall(function()
					return v.Value;
				end);
			if U and P ~= nil then
				return P;
			end;
		end;
	end;
	return nil;
end;
function LU.username()
	local U = a();
	if not U then
		return "?";
	end;
	local P = U.Name or "?";
	local m, v = pcall(function()
			return U.DisplayName;
		end);
	if m and (type(v) == "string" and (v ~= "" and v ~= P)) then
		return v .. (" (@" .. (P .. ")"));
	end;
	return P;
end;
function LU.stats()
	local U = s.running and ((t[s.phase] or s.phase)) or "idle";
	return string.format("**Stats**\nUser: %s\nStage: %s    Rod: %s\nCaught: %d    Lost: %d    Timeouts: %d", LU.username(), U, s.rod ~= "" and s.rod or "none", s.caught or 0, s.lost or 0, s.timeouts or 0);
end;
function LU.startup()
	local U = LU.leaderstat({ "Level", "Lvl", "level" });
	local P = LU.leaderstat({
			"Money",
			"Coins",
			"Cash",
			"C$",
			"Currency",
		});
	return string.format("**Started**\nUser: %s\nLevel: %s\nMoney: %s", LU.username(), U ~= nil and tostring(U) or "?", P ~= nil and tostring(P) or "?");
end;
function LU.maybeStartup()
	if LU.startedSent then
		return;
	end;
	if not ((L.webhook_enabled and (L.webhook_on_start and LU.validUrl(L.webhook_url)))) then
		return;
	end;
	LU.startedSent = true;
	LU.sendAsync(LU.startup());
end;
function LU.statsTick()
	if not ((L.webhook_enabled and (L.webhook_stats and LU.validUrl(L.webhook_url)))) then
		return;
	end;
	if (tick() - LU.lastStatsAt) < L.webhook_interval_s then
		return;
	end;
	LU.lastStatsAt = tick();
	LU.sendAsync(LU.stats());
end;
local OU = {};
OU.locations = {
		["Obsidian Pocket"] = Vector3.new(141.56, -6551.0, 48.81),
		["Boreal Hollow"] = Vector3.new(848.32, -2603.62, 1610.78),
		["Grand Reef"] = Vector3.new(-3577.17, 162.33, 503.51),
		["Desolate Deep"] = Vector3.new(-1512.57, -234.7, -2862.52),
		["Glacial Grotto (Summit)"] = Vector3.new(19990.91, 1142.24, 5550.1),
		Atlantis = Vector3.new(-4343.68, -602.31, 1813.18),
