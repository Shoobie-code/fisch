hU.SRC_LABEL = { exact = "exact spot", hub = "island hub (walk from there)", zone = "zone center (live lookup)" };
function hU.zonePos(U)
	if not U or U == "" then
		return nil;
	end;
	if not hU._zmap or (tick() - ((hU._zmapAt or 0))) > 5 then
		local U, P, m = pcall(vU, nil, {});
		hU._zmap = ((U and type(m) == "table")) and m or {};
		hU._zmapAt = tick();
	end;
	local P = string.lower(U);
	local m = nil;
	for U, v in pairs(hU._zmap) do
		local Y = string.lower(U);
		if Y == P then
			return v;
		end;
		if not m and ((Y:find(P, 1, true) or P:find(Y, 1, true))) then
			m = v;
		end;
	end;
	return m;
end;
function hU.pos(U)
	if U.pos then
		return U.pos, "exact";
	end;
	local P = OU.resolve(U.tp or U.zone);
	if P then
		return P, "hub";
	end;
	local m = hU.zonePos(U.zone);
	if m then
		return m, "zone";
	end;
	return nil, nil;
end;
function hU.match(U)
	if not U or U == "" then
		return nil;
	end;
	U = string.lower(U);
	local P, m, v;
	for Y, Q in ipairs(hU.catalog) do
		local a = string.lower(Q.name);
		if a == U then
			return Q;
		end;
		if not P and a:sub(1, #U) == U then
			P = Q;
		end;
		if not m and a:find(U, 1, true) then
			m = Q;
		end;
		if not v and (string.lower(Q.zone)):find(U, 1, true) then
			v = Q;
		end;
	end;
	return P or m or v;
end;
function hU.liveCheck(U, P)
	P = P or hU.pos(U);
	if not P then
		return nil, nil;
	end;
	local m = U.npc and string.lower(U.npc) or nil;
	local v, Y, Q;
	for U, a in ipairs(bU.snapshot()) do
		local C, K = pcall(function()
				return ((a.pos - P)).Magnitude;
			end);
		if C and K then
			if not v or K < v then
				v, Y = K, a.name;
			end;
			if m and (not Q and (K <= 500 and (string.lower(a.name)):find(m, 1, true))) then
				Q = a.pos;
			end;
		end;
	end;
	if Q then
		return Q, "verified - " .. (U.npc .. " on site");
	end;
	if v and v <= 60 then
		return nil, string.format("likely - %s [%d]", Y, math.floor(v));
	end;
	return nil, "unverified (too far)";
end;
function hU.describe(U)
	local P, m = hU.pos(U);
	local v, Y = hU.liveCheck(U);
	return string.format("%s\nWhere: %s\nHow: %s\nTeleport: %s%s", U.name, U.zone, U.how, m and hU.SRC_LABEL[m] or "n/a - no fixed spot", Y and ("\nLive check: " .. Y) or "");
end;
function hU.teleport(U)
	local P = hU.pos(U);
	if not P then
		notify(U.name .. (" has no fixed spot (" .. (U.zone .. ")")), "", 4);
		return false;
	end;
	local m = hU.liveCheck(U);
	if m then
		P = m;
	end;
	OU.toPos(P.X, P.Y, P.Z);
	return true;
end;
function GU.tpNearest()
	local U = YU();
	if #U == 0 then
		notify("No treasure chests up right now.", "", 3);
		return false;
	end;
	local P = k();
	local m, v;
	for U, Y in ipairs(U) do
		local Q = 0;
		if P then
			local U, m = pcall(function()
					return ((Y.pos - P)).Magnitude;
				end);
			Q = U and m or 0;
		end;
		if not v or Q < v then
			m, v = Y, Q;
		end;
	end;
	return m and OU.toPos(m.pos.X, m.pos.Y + 3, m.pos.Z) or false;
end;
function GU.tpNext()
	local U = YU();
	if #U == 0 then
		notify("No treasure chests up right now.", "", 3);
		return false;
	end;
	GU._cycle = (((GU._cycle or 0)) % #U) + 1;
	local P = U[GU._cycle];
	return OU.toPos(P.pos.X, P.pos.Y + 3, P.pos.Z);
end;
GU.run = {
		active = false,
		list = {},
		i = 1,
		stage = "tp",
		nextAt = 0,
		visited = 0,
	};
function GU.runStart()
	local U = GU.run;
	U.list = YU();
	U.i = 1;
	U.stage = "tp";
	U.nextAt = 0;
	U.visited = 0;
	U.active = #U.list > 0;
	notify(U.active and string.format("Chest run: visiting %d chest(s)...", #U.list) or "Chest run: no chests found.", "", 3);
end;
function GU.runStop()
	if not GU.run.active then
		return;
	end;
	GU.run.active = false;
	pcall(keyrelease, n.E);
	notify(string.format("Chest run stopped (%d visited).", GU.run.visited), "", 3);
end;
function GU.runStep()
	local U = GU.run;
	if not U.active then
		return;
	end;
	local P = tick() * 1000;
	if P < U.nextAt then
		return;
	end;
	if U.i > #U.list then
		U.active = false;
		notify(string.format("Chest run done: %d chest(s) visited.", U.visited), "", 3);
		return;
	end;
	local m = U.list[U.i].pos;
	if U.stage == "tp" then
		OU.toPos(m.X, m.Y, m.Z);
		U.stage = "press";
		U.nextAt = P + 150;
	else
		u(n.E, 150);
		U.visited = U.visited + 1;
		U.i = U.i + 1;
		U.stage = "tp";
		U.nextAt = P + 200;
	end;
end;
local function AU(U, P)
	local m, v = pcall(getgc, U);
	if not m or type(v) ~= "table" then
		return 0;
	end;
	local Y, Q = {}, 0;
	for U = 1, #v, 1 do
		local m = v[U];
		local a = type(m) == "table" and tonumber(m.addr);
		local C = type(m) == "table" and tonumber(m.value);
		if a and (a > 4096 and (C and tostring(m.type) == "number")) then
			local U, v = pcall(memory_read, "double", a);
			v = U and tonumber(v) or nil;
			if v and ((v == C or math.abs(v - C) <= 1e-09 * math.max(1, math.abs(C)))) then
				if v == P then
					Q = Q + 1;
				else
					Y[#Y + 1] = m;
				end;
			end;
		end;
	end;
	if #Y == 0 then
		return Q;
	end;
	local a, C = pcall(applygc, Y, U, P);
	return Q + (((a and tonumber(C)) or 0));
end;
local MU = {
		enabled = false,
		patched = false,
		lastLive = false,
		liveSince = nil,
		openHandled = false,
		job = nil,
		nextScanAt = 0,
		retryAt = 0,
		OPEN_HOLD = .25,
		SCAN_GAP = 1.0,
		RETRY_GAP = 15,
	};
function MU.startPatch()
	local U = tonumber(L.instant_reel_speed) or 50;
	local P = tonumber(L.instant_reel_loss) or 0;
	MU.job = {
			i = 1,
			n = 0,
			s = U,
			loss = P,
			keys = { { "progressefficiency", U }, { "progressLossMultiplier", P } },
		};
end;
function MU.runJob()
	local U = MU.job;
	if not U or tick() < MU.nextScanAt then
		return;
	end;
	local P = U.keys[U.i];
	U.n = U.n + AU(P[1], P[2]);
	U.i = U.i + 1;
	MU.nextScanAt = tick() + MU.SCAN_GAP;
	if U.i <= #U.keys then
		return;
	end;
	MU.job = nil;
	if U.n >= 2 then
		MU.patched = true;
		MU.appliedSpeed, MU.appliedLoss = U.s, U.loss;
		if MU.lastLive then
			x = true;
		end;
		notify("Instant reel active.", "", 3);
	else
		MU.retryAt = tick() + MU.RETRY_GAP;
	end;
end;
function MU.stale()
	return MU.appliedSpeed ~= ((tonumber(L.instant_reel_speed) or 50)) or MU.appliedLoss ~= ((tonumber(L.instant_reel_loss) or 0));
end;
function MU.setEnabled(U)
	MU.enabled = U and true or false;
	if not MU.enabled then
		MU.job = nil;
		return;
	end;
	if MU.patched then
		return;
	end;
	if not S() then
		notify("Instant reel arms when your next reel opens.", "", 4);
	end;
end;
function MU.step()
	if not ((MU.enabled or MU.patched)) then
		MU.lastLive = nil;
		MU.liveSince = nil;
		return;
	end;
	local U = tick();
	local P = S();
	if P then
		if not MU.liveSince then
			MU.liveSince = U;
			MU.openHandled = false;
		end;
		if not MU.openHandled and U - MU.liveSince >= MU.OPEN_HOLD then
			MU.openHandled = true;
			if MU.enabled and (not MU.job and (((not MU.patched or MU.stale())) and U >= MU.retryAt)) then
				MU.startPatch();
			end;
			if MU.patched then
				x = true;
			end;
		end;
	else
		MU.liveSince = nil;
		if MU.lastLive then
			if x and not ((s.running and s.phase == "FISHING")) then
				x = false;
			end;
		end;
	end;
	MU.lastLive = P;
	if MU.job then
		MU.runJob();
	end;
end;
do
	local P;
	local m = U and not rawget(_G, "UI_RELOAD");
	if m then
		_G.UI_RELOAD = true;
	end;
	if not rawget(_G, "UI_LOCAL") then
		pcall(function()
			P = game:HttpGet("https://raw.githubusercontent.com/Shoobie-code/linoria-inspired/refs/heads/main/main");
		end);
		if type(P) == "string" and #P > 1000 then
			pcall(writefile, "UILib.lua", P);
		else
			P = nil;
		end;
	end;
	if not P then
		pcall(function()
			P = readfile("UILib.lua");
		end);
	end;
	if type(P) == "string" then
		pcall(function()
			(loadstring(P))();
		end);
	end;
	if m then
		_G.UI_RELOAD = nil;
	end;
	local function v(U)
		if type(U) == "table" and (not U._dead and U.CreateWindow) then
			D = U;
		end;
	end;
	if type(getfenv) == "function" then
		pcall(function()
			v(rawget(getfenv(0), "UILib"));
		end);
	end;
	if not D then
		pcall(function()
			v(_G.UILib);
		end);
	end;
	if not D and type(getgenv) == "function" then
		pcall(function()
			v((getgenv()).UILib);
		end);
	end;
	if not D then
		warn("UI library failed to load, running console-only");
	end;
end;
local function lU()
	if not ((D and B)) then
		return;
	end;
	if _G.FischAppraiser then
		pcall(function()
			_G.FischAppraiser.unload();
		end);
	end;
	local U = {
			dead = false,
			conns = {},
			enabled = false,
			count = 0,
			delay = .35,
			pressHold = .05,
			held = false,
			pressedAt = 0,
			nextClick = 0,
			status = "idle",
			strictFilters = false,
			settle = 1.0,
			lastRaw = nil,
			requireAllQualities = true,
			filters = { sizes = {}, qualities = {}, mutations = {} },
			filterRows = {},
		};
	_G.FischAppraiser = U;
	function U.unload()
		U.dead = true;
		U.enabled = false;
		for U, P in ipairs(U.conns) do
			pcall(function()
				P:Disconnect();
			end);
		end;
		if U.held then
			pcall(mouse1release);
			U.held = false;
		end;
	end;
	local P = {
			"Giant",
			"Big",
			"Small",
			"Tiny",
		};
	local m = { "Shiny", "Sparkling", "Glitched" };
	local Y = {
			"Albino",
			"Darkened",
			"Negative",
			"Glossy",
			"Bioluminescent",
			"Lunar",
			"Translucent",
			"Electric",
			"Hexed",
			"Silver",
			"Entrenched",
			"Frozen",
			"Mosaic",
			"Scorched",
			"Amber",
			"Abyssal",
			"Coral",
			"Decayed",
			"Poisoned",
			"Fossilized",
			"Vined",
			"Crimson",
			"Honey",
			"Midas",
			"Boreal",
			"Fallen",
			"Greedy",
			"Spirit",
			"Mourned",
			"Mythical",
			"Shrouded",
			"Beached",
			"Paradise",
			"Tanned",
			"Tropica",
			"Super-Tanned",
			"Petrified",
		};
	local Q, a = {}, {};
	for U, P in ipairs(P) do
		Q[P:lower()] = true;
	end;
	for U, P in ipairs(m) do
		a[P:lower()] = true;
	end;
	local function C(U)
		return (((tostring(U or "")):gsub("\226\128\153", "\'")):lower());
	end;
	local function K(U, P)
		U = tostring(U or "");
		if #U > P then
			return U:sub(1, P - 2) .. "..";
		end;
		return U;
	end;
	local function G()
		for U, P in ipairs(X()) do
			for U, P in ipairs(q(P)) do
				local m, v = pcall(function()
						return P.ClassName;
					end);
				if m and v == "Tool" then
					return P;
				end;
			end;
		end;
		return nil;
	end;
	local L = 208;
	local function O(U)
		if type(memory_read) ~= "function" then
			return false;
		end;
		local P = H(U, "UIStroke");
		if not P then
			return false;
		end;
		local m, v = pcall(function()
				return P.Parent and P.Address;
			end);
		v = m and tonumber(v) or nil;
		if not v or v <= 4096 then
			return false;
		end;
		for U = 0, 2, 1 do
			local P, m = pcall(memory_read, "float", (v + L) + U * 4);
			m = P and tonumber(m) or nil;
			if not m or m < .9 or m > 1.001 then
				return false;
			end;
		end;
		return true;
	end;
	local function b(U)
		local P = H(U, "ItemName");
		if P then
			return P;
		end;
		local m, v = pcall(function()
				return U:GetDescendants();
			end);
		if m and type(v) == "table" then
			for U, P in ipairs(v) do
				if P.Name == "ItemName" then
					return P;
				end;
			end;
		end;
		return nil;
	end;
	local function h(U)
		if not U then
			return nil, 0;
		end;
		local P;
		pcall(function()
			P = tostring(U.Name);
		end);
		P = P or "";
		local m = y();
		local v = m and H(m, "backpack");
		local Y = P:lower();
		local Q = " " .. Y;
		local a, C, K, G = nil, nil, nil, 0;
		local L, h, A = nil, 0, 0;
		local function M(U, P)
			if not U then
				return;
			end;
			for U, m in ipairs(q(U)) do
				local v = b(m);
				local M, l = pcall(function()
						return v and v.Text;
					end);
				if M and (type(l) == "string" and l ~= "") then
					l = l:gsub("<[^>]+>", "");
					local U = l:lower();
					local v = U == Y;
					if v or (#U > #Q and U:sub(-(#Q)) == Q) then
						A = A + 1;
						if not a and O(m) then
							a = l;
						end;
						if not P then
							h, L = h + 1, l;
						elseif v then
							C = C or l;
						elseif #l > G then
							K, G = l, #l;
						end;
					end;
				end;
			end;
		end;
		M(v and H(v, "hotbar"), true);
		local l = v and H(v, "inventory");
		M(l and H(l, "itemContainer"), false);
		if a then
			return a, A, "held";
		end;
		if C or K then
			return C or K, A, "hotbar";
		end;
		if h == 1 then
			return L, A, "inventory";
		end;
		return nil, A;
	end;
	local function A(U, P)
		local m = C(U);
		local v = C(P or "");
		local Y = m;
		if v ~= "" then
			if m == v then
				Y = "";
			else
				local U = " " .. v;
				if #m > #U and m:sub(-(#U)) == U then
					Y = m:sub(1, #m - #U);
				end;
			end;
		end;
		local K, G, L = nil, {}, {};
		for U in Y:gmatch("%S+") do
			if Q[U] then
				K = K or U;
			elseif a[U] then
				G[U] = true;
			else
				L[#L + 1] = U;
			end;
		end;
		return K, G, table.concat(L, " ");
	end;
	local function M(U)
		for U, P in pairs(U) do
			if P then
				return true;
			end;
		end;
		return false;
	end;
	local function l(U, P)
		return U == P or U:sub(1, #P + 1) == P .. " ";
	end;
	local function T(P)
		local m = M(U.filters.sizes);
		local v = M(U.filters.qualities);
		local Y = M(U.filters.mutations);
		if not m and (not v and not Y) then
			return "click", "no filters selected -- rolling unconditionally";
		end;
		if not P then
			return (U.strictFilters and "hold" or "click"), "no fish equipped -- nothing to parse, " .. ((U.strictFilters and "strict mode: holding" or "rolling anyway (tick Strict Filtering to hold instead)"));
		end;
		local Q, a, C = h(P);
		local K;
		pcall(function()
			K = tostring(P.Name);
		end);
		K = K or "";
		if not Q then
			return "hold", ((a == 0 and "no slot shows \'" .. (K .. "\'") or a .. (" \'" .. (K .. "\' slots, none marked held")))) .. " -- holding; pin the fish to the hotbar";
		end;
		local G, L, O = A(Q, K);
		local b = true;
		if m then
			b = G ~= nil and U.filters.sizes[G] == true;
		end;
		local T = true;
		if v then
			if U.requireAllQualities then
				T = true;
				for U, P in pairs(U.filters.qualities) do
					if P and not L[U] then
						T = false;
						break;
					end;
				end;
			else
				T = false;
				for U, P in pairs(U.filters.qualities) do
					if P and L[U] then
						T = true;
						break;
					end;
				end;
			end;
		end;
		local c = true;
		if Y then
			c = false;
			for U, P in pairs(U.filters.mutations) do
				if P and l(O, U) then
					c = true;
					break;
				end;
			end;
		end;
		local e = { "\'" .. (Q .. "\'") };
		if a > 1 and C ~= "held" then
			e[#e + 1] = "(!" .. (a .. (" slots share this species, read the " .. (C .. " one)")));
		end;
		if m then
			e[#e + 1] = "size=" .. tostring(G);
		end;
		if v then
			local P = {};
			for U in pairs(L) do
				P[#P + 1] = U;
			end;
			table.sort(P);
			e[#e + 1] = "quality=" .. (((#P > 0 and table.concat(P, "+") or "nil")) .. ((U.requireAllQualities and " [need all]" or "")));
		end;
		if Y then
			e[#e + 1] = "rest=\'" .. (O .. "\'");
		end;
		local i = b and (T and c);
		return (i and "stop" or "click"), table.concat(e, " ") .. ((i and " -> HIT, stopping" or " -> no hit, rolling")), Q;
	end;
	local c = B:AddTab("Appraise");
	local e = c:AddGroup("Appraise", 1);
	U.autoToggle = e:AddToggle({ text = "Auto Appraise", default = false, callback = function(P)
				if U.dead then
					return;
				end;
				U.enabled = P and true or false;
				if U.enabled then
					U.nextClick = 0;
				end;
			end });
	U.autoToggle:AddKeybind({ flag = "appraise_key", default = "F4" });
	e:AddSlider({
		text = "Click interval",
		flag = "appraise_delay",
		default = U.delay,
		step = .05,
		min = .1,
		max = 3,
		suffix = "s",
		callback = function(P)
			U.delay = P;
		end,
	});
	e:AddSlider({
		text = "Press hold",
		flag = "appraise_hold",
		default = U.pressHold,
		step = .01,
		min = .03,
		max = .3,
		suffix = "s",
		callback = function(P)
			U.pressHold = P;
		end,
		tooltip = "How long the click stays down. Below ~0.04s Roblox tends to drop it -- raise this if clicks stop registering.",
	});
	local i = c:AddGroup("Status", 2);
	U.lblStatus = i:AddLabel({ text = "Status: idle" });
	U.lblCount = i:AddLabel({ text = "Clicks this session: 0" });
	local R = c:AddGroup("Mutations", 2);
	U.mutDrop = R:AddDropdown({
			text = "Mutations",
			flag = "appraise_mutations",
			values = Y,
			multi = true,
			default = {},
			callback = function(P)
				local m = {};
				if type(P) == "table" then
					for U, P in pairs(P) do
						if P then
							m[C(U)] = true;
						end;
					end;
				end;
				U.filters.mutations = m;
			end,
		});
	local V = c:AddGroup("Size", 1);
	for P, m in ipairs(P) do
		local v = m:lower();
		U.filterRows[#U.filterRows + 1] = V:AddToggle({
				text = m,
				flag = "appraise_size_" .. v,
				default = false,
				callback = function(P)
					U.filters.sizes[v] = P;
				end,
			});
	end;
	local j = c:AddGroup("Quality", 2);
	for P, m in ipairs(m) do
		local v = m:lower();
		U.filterRows[#U.filterRows + 1] = j:AddToggle({
				text = m,
				flag = "appraise_quality_" .. v,
				default = false,
				callback = function(P)
					U.filters.qualities[v] = P;
				end,
			});
	end;
	local Z = c:AddGroup("Advanced", 1);
	Z:AddToggle({
		text = "Strict Filtering",
		flag = "appraise_strict",
		default = false,
		callback = function(P)
			U.strictFilters = P;
		end,
		tooltip = "Only affects the case where no fish is equipped at all. Off = click anyway (default). On = hold until a fish is in hand.",
	});
	U.customBox = Z:AddTextbox({ text = "Custom mutation name", default = "" });
	Z:AddButton({ text = "Save Mutation", callback = function()
			local P = ((tostring(U.customBox:Get() or "")):gsub("^%s*(.-)%s*$", "%1"));
			if P == "" then
				return;
			end;
			local m, v = C(P), false;
			for U, Y in ipairs(Y) do
				if C(Y) == m then
					P, v = Y, true;
					break;
				end;
			end;
			if not v then
				Y[#Y + 1] = P;
				U.mutDrop:SetValues(Y);
			end;
			local Q = {};
			for U, P in pairs(U.mutDrop:Get() or {}) do
				Q[U] = P;
			end;
			Q[P] = true;
			U.mutDrop:Set(Q);
			pcall(function()
				D:Notify({ title = "Saved", text = P, duration = 2 });
			end);
		end });
	local f = c:AddGroup("Stop", 1);
	f:AddButton({ text = "Reset filters", callback = function()
			for U, P in ipairs(U.filterRows) do
				pcall(function()
					P:Set(false);
				end);
			end;
			pcall(function()
				U.mutDrop:Set({});
			end);
			pcall(function()
				U.customBox:Set("");
			end);
			U.filters.sizes, U.filters.qualities, U.filters.mutations = {}, {}, {};
			pcall(function()
				D:Notify({ title = "Appraise", text = "Filters cleared.", duration = 2 });
			end);
		end });
	f:AddButton({ text = "Stop", callback = function()
			U.enabled = false;
			pcall(function()
				U.autoToggle:Set(false);
			end);
		end });
	local function k(P, m, v)
		if U[m] == v then
			return;
		end;
		U[m] = v;
		pcall(function()
			P:SetText(v);
		end);
	end;
	U.conns[#U.conns + 1] = v.Heartbeat:Connect(function()
			if U.dead then
				return;
			end;
			local P = tick();
			if P - ((U._uiAt or 0)) >= .2 then
				U._uiAt = P;
				k(U.lblStatus, "_s1", "Status: " .. K(U.status, 44));
				k(U.lblCount, "_s2", "Clicks this session: " .. U.count);
			end;
			if U.held then
				if P - U.pressedAt >= U.pressHold then
					pcall(mouse1release);
					U.held = false;
					U.nextClick = P + U.delay;
				end;
				return;
			end;
			if not U.enabled then
				return;
			end;
			if P < U.nextClick then
				return;
			end;
			if not N() then
				return;
			end;
			local m, v = pcall(function()
					local m, v, Y = T(G());
					if m == "click" and (Y and (Y == U.lastRaw and P < U.pressedAt + U.settle)) then
						U.status = v .. " (waiting for the last roll to show)";
						U.nextClick = P + .05;
						return;
					end;
					U.status = v;
					if m == "click" then
						U.lastRaw = Y;
						mouse1press();
						U.held = true;
						U.pressedAt = P;
						U.count = U.count + 1;
					elseif m == "stop" then
						U.enabled = false;
						U.status = v .. (" (auto appraise off after " .. (U.count .. " rolls)"));
						print("[Appraise] HIT after " .. (U.count .. (" rolls -- " .. v)));
						pcall(function()
							U.autoToggle:Set(false);
						end);
						pcall(function()
							D:Notify({ title = "Got it", text = v, duration = 8 });
						end);
						pcall(function()
							notify("Got it after " .. (U.count .. " appraises."), "", 8);
						end);
					else
						U.nextClick = P + U.delay;
					end;
				end);
			if not m then
				U.status = "error: " .. tostring(v);
				U.enabled = false;
				if U.held then
					pcall(mouse1release);
					U.held = false;
				end;
			end;
		end);
end;
