
-- A shared UILib whose loop has stopped (the run that owned it died) stays in memory, and
-- every later load would reuse it: a menu on screen that ignores every click. The library
-- stamps _now each frame. Checked first, before anything slow: the offset and library
-- downloads below block the VM, and while they do even a healthy library cannot stamp.
local UI_STALE = (function()
	local prev = rawget(_G, "UILib");
	local beat = type(prev) == "table" and tonumber(rawget(prev, "_now"));
	return type(beat) == "number" and (tick() - beat) > 3;
end)();

local function tryService(name) -- fetches a service, tolerating either lookup style
	local ok, svc = pcall(function() -- GetService is the normal path but can throw
		return game:GetService(name);
	end);
	if ok and svc then
		return svc;
	end;
	local okDot, direct = pcall(function() -- fall back to indexing game directly
		return game[name];
	end);
	return (okDot and direct) or nil;
end;

local function resolveService(name) -- retries a service lookup for up to 15s while the game loads
	for _ = 1, 150 do
		local svc = tryService(name);
		if svc then
			return svc;
		end;
		wait(.1); -- pause between attempts
	end;
	return nil;
end;

local Players = resolveService("Players"); -- needed for LocalPlayer, PlayerGui and the mouse
local RunService = resolveService("RunService"); -- needed for the Heartbeat loop at the bottom

if not (Players and RunService) then -- nothing can run without both, so bail out loudly
	notify("Services never resolved - re-run AutoFish once the game has loaded.", "AutoFish", 6);
	return;
end;

if _G.JustAutofish and type(_G.JustAutofish.stop) == "function" then -- tear down a previous run
	pcall(_G.JustAutofish.stop);
end;
_G.JustAutofish = {}; -- fresh namespace for this instance

local function getLocalPlayer() -- read live each time, since it can be nil early on
	return Players.LocalPlayer;
end;

if type(setrobloxinput) == "function" then -- let synthetic input reach the game window
	setrobloxinput(true);
end;
pcall(mouse1release); -- clear a left button a previous run may have left down

if type(memory_read) ~= "function" then -- every GUI read below depends on this
	notify("Enable Unsafe LuaU in Matcha - memory reads required.", "AutoFish", 6);
end;

