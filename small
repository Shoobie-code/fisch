				config = "fisch.json", -- same file and same key names as before
				inputGuard = function() -- ignore the clicks the macro itself holds
					return mouseHeld;
				end,
				captureInput = function() -- the macro's own input must always reach the game
					return not enabled;
				end,
				onUnload = function() -- Settings > unload
					local api = _G.JustAutofish;
					if api and type(api.stop) == "function" then
