					return CONFIG.mode == "rod";
				end,
				hideDisabled = true,
				callback = function(v)
					CONFIG.castPower = v;
					STATE.castThreshold = getCastThreshold(); -- apply mid-cycle too
				end,
			});

		macro:AddSlider({
